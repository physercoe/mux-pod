{
  "name": "termipod-electron",
  "private": true,
  "version": "0.0.0-dev",
  "description": "TermiPod desktop Electron shell (ADR-055 M1). Wraps the same Vite build (../dist) the Tauri shell ships; the frontend talks to it through the runtime-agnostic src/bridge/. Self-contained package (own deps) so the Tauri release build never installs Electron.",
  "author": "TermiPod contributors",
  "homepage": "https://github.com/physercoe/termipod",
  "main": "out/main.cjs",
  "dependencies": {
    "@huggingface/gguf": "^0.4.6",
    "@napi-rs/keyring": "^2.0.0",
    "electron-updater": "^6.3.9",
    "extract-zip": "^2.0.1",
    "jszip": "^3.10.1",
    "node-pty": "^1.0.0",
    "protobufjs": "^8.8.0",
    "ssh2": "^1.16.0",
    "sshpk": "^1.18.0",
    "undici": "^8.10.1",
    "ws": "^8.21.3"
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'src/**/*.test.ts'",
    "test:e2e": "playwright test",
    "start": "npm run build && electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "overrides": {
    "node-gyp": "^10.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/aws4": "^1.11.6",
    "@types/node": "^26.4.1",
    "@types/ssh2": "^1.15.6",
    "@types/sshpk": "^1.17.0",
    "@types/ws": "^8.5.12",
    "aws4": "^1.13.2",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
