{
  "name": "termipod-desktop",
  "private": true,
  "version": "2026.817.322",
  "type": "module",
  "description": "TermiPod desktop control plane — the unified web-tech client shell (WS2 of docs/plans/desktop-control-plane.md). Browser-target build; the Electron shell (desktop/electron) packages it (ADR-055).",
  "scripts": {
    "dev": "npm run sync:tokens && npm run sync:excalidraw && npm run sync:treesitter && npm run sync:modelexplorer && vite",
    "build": "npm run sync:tokens && npm run sync:excalidraw && npm run sync:treesitter && npm run sync:modelexplorer && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'src/**/*.test.ts'",
    "preview": "vite preview",
    "sync:tokens": "node ../design-tokens/build.mjs && cp ../design-tokens/build/tokens.css src/styles/tokens.css",
    "sync:excalidraw": "node scripts/sync-excalidraw-assets.mjs",
    "sync:treesitter": "node scripts/sync-treesitter-assets.mjs",
    "sync:modelexplorer": "node scripts/sync-model-explorer-assets.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.2",
    "@codemirror/view": "^6.43.11",
    "@excalidraw/excalidraw": "^0.18.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@git-diff-view/react": "^0.1.7",
    "@hpcc-js/wasm-graphviz": "^1.28.0",
    "@lezer/highlight": "^1.2.3",
    "@milkdown/crepe": "^7.22.1",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-query-persist-client": "^5.102.8",
    "@vscode/tree-sitter-wasm": "^0.3.1",
    "@xterm/addon-canvas": "^0.7.0",
    "@xterm/addon-clipboard": "^0.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-ligatures": "^0.10.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.11.6",
    "anser": "^2.3.5",
    "echarts": "^6.1.0",
    "elkjs": "^0.12.0",
    "epubjs": "^0.3.93",
    "katex": "^0.18.5",
    "mermaid": "^11.17.2",
    "nomnoml": "^1.7.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-virtuoso": "^4.18.12",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sql.js": "^1.14.2",
    "three": "^0.185.1",
    "vega": "^6.4.0",
    "vega-lite": "^6.4.3",
    "wavedrom": "^3.7.0",
    "web-tree-sitter": "^0.27.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/sql.js": "^1.4.11",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.1.1",
    "ai-edge-model-explorer-visualizer": "^0.1.2",
    "typescript": "^7.0.2",
